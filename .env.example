# Landing Page — Environment Variables
# Salin file ini ke .env.local lalu isi nilainya

# URL platform LMS
NEXT_PUBLIC_LMS_URL=https://lms.webzoka.com

# URL platform Jastip — digunakan di SegmenSection
NEXT_PUBLIC_JASTIP_URL=https://jastip.webzoka.com

# URL landing page ini sendiri (untuk canonical & OG tags)
NEXT_PUBLIC_LANDING_URL=https://www.webzoka.com

# URL platform Klinik & Medis
NEXT_PUBLIC_CLINIC_URL=https://clinic.webzoka.com/auth/login

# Nomor WhatsApp utama (tanpa + dan tanpa 0 di depan)
NEXT_PUBLIC_WA_NUMBER=6281296917963

# URL portal Website Builder (deployment yang menyajikan situs klien published)
NEXT_PUBLIC_WEBSITEBUILDER_URL=https://wb.webzoka.com

# Supabase websitebuilder — dipakai galeri "Karya Kami" untuk fetch situs published.
# Anon key bersifat publik & read-only (RLS hanya izinkan baris status='published').
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
