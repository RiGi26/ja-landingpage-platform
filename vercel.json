{
  "redirects": [
    {
      "source": "/store",
      "destination": "https://store.webzoka.com/store",
      "permanent": true
    },
    {
      "source": "/store/",
      "destination": "https://store.webzoka.com/store",
      "permanent": true
    },
    {
      "source": "/store/template/warm-commerce",
      "destination": "https://store.webzoka.com/store/template/warm-commerce",
      "permanent": true
    },
    {
      "source": "/store/template/warm-commerce/",
      "destination": "https://store.webzoka.com/store/template/warm-commerce",
      "permanent": true
    },
    {
      "source": "/store/template/warm-commerce/preview",
      "destination": "https://store.webzoka.com/store/template/warm-commerce/preview",
      "permanent": true
    },
    {
      "source": "/store/template/warm-commerce/preview/",
      "destination": "https://store.webzoka.com/store/template/warm-commerce/preview",
      "permanent": true
    },
    {
      "source": "/store/customize/warm-commerce",
      "destination": "https://store.webzoka.com/store/customize/warm-commerce",
      "permanent": true
    },
    {
      "source": "/store/customize/warm-commerce/",
      "destination": "https://store.webzoka.com/store/customize/warm-commerce",
      "permanent": true
    },
    {
      "source": "/store/summary",
      "destination": "https://store.webzoka.com/store/summary",
      "permanent": true
    },
    {
      "source": "/store/summary/",
      "destination": "https://store.webzoka.com/store/summary",
      "permanent": true
    },
    {
      "source": "/store/:path*",
      "destination": "https://store.webzoka.com/store/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
